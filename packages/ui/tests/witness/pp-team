#!/usr/bin/env python3
"""pp-team -- the bench's WITNESS of the faces of `team`, for the Teams tab of the post. Posed by
`PP_UI_FACES` under the name `team`, it replays the script `PP_UI_TEAM_SCRIPT` names -- a JSON
object: `badges` (the objects `status --json` prints without a name, one per line), `states`
(`{<team>: [<object>, …]}`: what `status <team> --json` prints, ONE object per call, consumed call
after call, the last one replayed), `refuse` (`{<team>: "<line>"}`: the line said on stderr, exit 2,
for `status <team>`), `watch` (`{<team>: [<object> | {"sleep": <seconds>}, …]}`, a task's under
`<team>/<task>` for `watch <team> --task <task>`: what the watch writes on STDERR, one object per line,
`at` added when absent and `team` to an event of the journal -- an object with an `id`, or `quiet` --,
never to a STEP of a wake-up; `{"until": "<line>"}` holds the watch until the journal of `agent`'s witness
(`PP_UI_CHAT_LOG`) carries that line, `UNTIL_BOUND` seconds at most -- past them, `until-missed <line>` is appended
to its own journal and the watch goes on; then it waits until it is ended), `log` (`{<team>: [<object>, …]}`, a
task's under `<team>/<task>`: what `log <team> --json [--task <task>]` prints, one per line -- a `{"sleep": <seconds>}`
among them makes the verb tarry that long -- or a list
of such lists, one per call, consumed call after call, the last one replayed),
`results` (`{<team>/<task>: <value>}`: what `result <team> <task>` prints as JSON; a task without one
refuses `task-open`, exit 2), `deletes` (`{<team>: <object>}`: what `delete <team> --json` prints without `--yes`;
with `--yes` it is a gesture, and once it answers rc 0 the team leaves what `status` prints without a name), `responses` (`{<team>: [<object>, …]}`: what `responses <team> --json [--agent <member>]` prints, one per
line, those of the member named alone), `inbox` (`{<team>: <object>}`: what `inbox <team> --json` prints on one
line, nothing when the team has none), `declarations` (`{<team>: <object>}`: what `declaration <team> --json`
prints; a team without one refuses `team-unknown`, exit 2), `templates` (`[<object>, …]`: the sorts `templates --json`
prints, one per line, each `{sort, description, origin, mandatory, default, composes, templates}`; `renders` what
`templates --render` makes of a template (`rendered`); `sources` (`{<template>: <text>}`) the text `document
<template> --json` says of a document, the documents a `document --new` created since added -- to `templates --json`
too, as the house's --, and those a `document --delete` removed taken out (`<log>.documents.json`); without `--json`,
each sort
under its title, then one line `  <template>  <members> -- <description>` per template), `stats` (`{<team>: {seasons, median, by_task, sleep}}`: every season of
the team, oldest first, each an object as `stats <team> --json` says it under `season` -- `stats <team> --json` prints
the last one, `--season <n>` that one, `--all` those not `empty` with the script's `median`, the numbers of the
empty ones and the script's `by_task`, each task over all its seasons, after `sleep` seconds when given; a team without seasons refuses `team-not-started`, exit 2), `answers` (`{<verb>: {rc, out, err, sleep}}`: what a GESTURE
-- `post`, `stop`, `tick`, `inbox --seen`, `reset`, `pause`, `resume`, `start`, `ring`, `budget`, `declare`, `delete`, `rename`, `recurrence`,
`document` with `--new`, `--body-file` or `--delete` -- answers, `declare --season` apart when named, rc 0 and nothing
said by default, `sleep` the seconds it tarries before it answers, then `ended team <argv>` appended to the log; a `declare --json` that answers rc 0 prints its face `{team, file, written, verdict, pending}`, its
`verdict` the answer's own when it gives one, `ok` otherwise). With `PP_UI_TEAM_LOG` named, one line per call is
appended -- `status`, `status <team>`, `watch
<team> [<task>]`, `log <team> [<task>]`, `result <team> <task>`, `inbox <team>`, `declaration <team>`, `stats <team> [--all | --season <n>]`, `templates`,
and a
gesture as `team <its argv, quoted as a shell would>` -- `team declare <name> --template <t> …` kept as typed --, and
`body <json>` after a gesture that reads its body on its standard input (`--body-file -`), the text it read, and
`watch-end <team> [<task>]` when a watch is ended by SIGTERM: how the bench counts the readings and
sees a watch closed. The calls of `status <team>` consumed are kept beside the journal
(`<log>.seen.json`), the teams deleted (`<log>.deleted.json`), and the teams a `stop` answered rc 0 stopped
(`<log>.stopped.json`): their `declaration` says `started.state` `stopped` from then on, as the verb's does."""
from __future__ import annotations

import fcntl
import json
import os
import shlex
import signal
import sys
import time
from datetime import datetime, timezone
from pathlib import Path


def log(line: str) -> None:
    where = os.environ.get("PP_UI_TEAM_LOG")
    if where:
        with open(where, "a", encoding="utf-8") as journal:
            journal.write(line + "\n")


def consumed(team: str) -> int:
    """-> how many `status <team>` calls were played before this one, and counts this one -- under a lock: the post
    reads several teams at once."""
    where = os.environ.get("PP_UI_TEAM_LOG")
    if not where:
        return 0
    path = Path(where + ".seen.json")
    with open(where + ".seen.lock", "a", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        seen = json.loads(path.read_text(encoding="utf-8")) if path.is_file() else {}
        before = int(seen.get(team, 0))
        seen[team] = before + 1
        path.write_text(json.dumps(seen), encoding="utf-8")
    return before


def deleted() -> list[str]:
    """-> the teams a `delete --yes` removed, kept beside the journal."""
    where = os.environ.get("PP_UI_TEAM_LOG")
    path = Path(where + ".deleted.json") if where else None
    return json.loads(path.read_text(encoding="utf-8")) if path is not None and path.is_file() else []


def stopped() -> list[str]:
    """-> the teams a `stop` answered rc 0 stopped, kept beside the journal."""
    where = os.environ.get("PP_UI_TEAM_LOG")
    path = Path(where + ".stopped.json") if where else None
    return json.loads(path.read_text(encoding="utf-8")) if path is not None and path.is_file() else []


def status(words: list[str], script: dict) -> int:
    if not words:
        log("status")
        gone = deleted()
        for one in script.get("badges") or []:
            if one.get("team") not in gone:
                print(json.dumps(one))
        return 0
    team = words[0]
    log(f"status {team}")
    refused = (script.get("refuse") or {}).get(team)
    if refused:
        sys.stderr.write(str(refused) + "\n")
        return 2
    states = (script.get("states") or {}).get(team) or [{"team": team, "started": None}]
    print(json.dumps(states[min(consumed(team), len(states) - 1)]))
    return 0


UNTIL_BOUND = 10.0                         # seconds a watch holds for a line of `agent`'s journal, at most


def held_until(line: str) -> None:
    """Returns once the journal of `agent`'s witness carries `line` -- what the post did, not a time --, or after
    `UNTIL_BOUND` seconds, `until-missed <line>` then appended to the journal: the case reads that its door was not
    seen."""
    where = os.environ.get("PP_UI_CHAT_LOG")
    deadline = time.monotonic() + UNTIL_BOUND
    while time.monotonic() < deadline:
        if where and Path(where).is_file() and line in Path(where).read_text(encoding="utf-8").splitlines():
            return
        time.sleep(0.05)
    log(f"until-missed {line}")


def watch(words: list[str], task: str | None, script: dict) -> int:
    team = words[0] if words else "?"
    named = f"{team} {task}" if task else team
    log(f"watch {named}")

    def ended(*_: object) -> None:
        log(f"watch-end {named}")
        raise SystemExit(0)
    signal.signal(signal.SIGTERM, ended)
    for one in (script.get("watch") or {}).get(f"{team}/{task}" if task else team) or []:
        if "sleep" in one:
            time.sleep(float(one["sleep"]))
            continue
        if "until" in one:
            held_until(str(one["until"]))
            continue
        event = "id" in one or one.get("event") == "quiet"     # a step of a wake-up names no team
        said = {"at": datetime.now(timezone.utc).isoformat(timespec="seconds"), **({"team": team} if event else {}),
                **one}
        sys.stderr.write(json.dumps(said) + "\n")
        sys.stderr.flush()
    while True:                            # a watch runs until it is ended
        time.sleep(1)


def journal(words: list[str], task: str | None, script: dict) -> int:
    team = words[0] if words else "?"
    log(f"log {team} {task}" if task else f"log {team}")
    key = f"{team}/{task}" if task else team
    found = (script.get("log") or {}).get(key) or []
    if found and isinstance(found[0], list):               # one list per call
        found = found[min(consumed(f"log:{key}"), len(found) - 1)]
    for one in found:
        if "sleep" in one and "event" not in one:          # a verb that tarries before it answers
            time.sleep(float(one["sleep"]))
            continue
        print(json.dumps(one))
    return 0


def responses(given: list[str], script: dict) -> int:
    """`responses <team> --json [--agent <member>]`: the script's responses of the team, the member's alone."""
    member = given[given.index("--agent") + 1] if "--agent" in given and given.index("--agent") + 1 < len(given) else None
    team = next((one for one in given if not one.startswith("--") and one != member), "?")
    log(f"responses {team} {member}" if member else f"responses {team}")
    for one in (script.get("responses") or {}).get(team) or []:
        if member is None or one.get("member") == member:
            print(json.dumps(one))
    return 0



def result(words: list[str], script: dict) -> int:
    team, task = (words + ["?", "?"])[:2]
    log(f"result {team} {task}")
    found = script.get("results") or {}
    if f"{team}/{task}" not in found:
        sys.stderr.write(f"pp-team: task-open -- {task} is open: no result yet.\n")
        return 2
    print(json.dumps(found[f"{team}/{task}"]))
    return 0


GESTURES = ("post", "stop", "tick", "inbox", "reset", "pause", "resume", "start", "ring", "budget", "declare", "delete",
            "rename", "recurrence", "document")
ACTIONS = ("--new", "--body-file", "--delete")      # what makes `document` a gesture; without one, a reading


def journal_last_body() -> str:
    """-> the last body the journal kept (`body <json>`), as its JSON."""
    where = os.environ.get("PP_UI_TEAM_LOG")
    lines = Path(where).read_text(encoding="utf-8").splitlines() if where and Path(where).is_file() else []
    return next((one[len("body "):] for one in reversed(lines) if one.startswith("body ")), '""')


def documents() -> dict:
    """-> the documents a `document` gesture changed, kept beside the journal: `{<template>: <text> | None}`, None for one
    deleted."""
    where = os.environ.get("PP_UI_TEAM_LOG")
    path = Path(where + ".documents.json") if where else None
    return json.loads(path.read_text(encoding="utf-8")) if path is not None and path.is_file() else {}


def documents_kept(found: dict) -> None:
    where = os.environ.get("PP_UI_TEAM_LOG")
    if where:
        Path(where + ".documents.json").write_text(json.dumps(found), encoding="utf-8")


def listed(script: dict) -> list[dict]:
    """-> the script's templates, each document a `document --delete` removed taken out, each one `--new` created
    added as the house's."""
    changed = documents()
    found = [one for one in script.get("templates") or [] if changed.get(one.get("template"), "") is not None]
    known = {one.get("template") for one in found}
    found += [{"template": name, "kind": "document", "origin": "house", "description": "", "values": []}
              for name, text in changed.items() if text is not None and name not in known]
    return found


def source(words: list[str], script: dict) -> int:
    """`document <template> --json`: the text the house sees of a document -- the one a gesture wrote, else the
    script's `sources` -- as ONE object `{template, origin, kind, path, text}`; `document-unknown` without one."""
    name = words[0] if words else "?"
    log(f"document {name}")
    changed = documents()
    text = changed[name] if name in changed else (script.get("sources") or {}).get(name)
    entry = next((one for one in listed(script) if one.get("template") == name), {})
    if text is None:
        sys.stderr.write(f"pp-team: document-unknown -- `{name}`: no such document.\n")
        return 2
    print(json.dumps({"template": name, "origin": entry.get("origin", "house"), "kind": "document",
                      "path": f".pp/teams/templates/{name}.md", "text": text}))
    return 0


def templates(as_json: bool, script: dict) -> int:
    """`templates [--json]`: the script's sorts, one object per sort and per line, its templates under it; without
    `--json`, each sort under its title, then one line per template."""
    log("templates --json" if as_json else "templates")
    for one in listed(script):
        if as_json:
            print(json.dumps(one))
            continue
        print(f"{one.get('sort')}  {'mandatory' if one.get('mandatory') else 'optional'} · "
              f"{'default ' + one['default'] if one.get('default') else 'no default'} -- {one.get('description')}")
        for template in one.get("templates") or []:
            members = f"  {', '.join(template['members'])}" if "members" in template else ""
            print(f"  {template.get('template')}{members} -- {template.get('description')}")
    return 0


def values_written(text: str | None) -> dict[str, str]:
    """-> the values a values file writes under `values: |`, `<name> = <value>` per line."""
    lines = str(text or "").split("\n")
    at = next((n for n, line in enumerate(lines) if line.startswith("values:")), None)
    found: dict[str, str] = {}
    for line in lines[at + 1:] if at is not None else []:
        if not line.startswith(" "):
            break
        if "=" in line:
            found[line.partition("=")[0].strip()] = line.partition("=")[2].strip()
    return found


def rendered(words: list[str], script: dict) -> int:
    """`templates --render <template> [--value <name>=<value>]... [--team <team> [--season] --text-file -] [--json]`:
    the document of the script's `renders` (`{<template>: {text, values: [{name, description, default}]}}`) for those
    values -- each hole `{<name>}` of its text given its value, else under `--team` the value its declaration applies
    (`declared.values` of the script's `declarations`; under `--text-file -`, the values the candidate read on the
    standard input writes in the place of TEAM.md -- of SEASON.md under `--season` --, SEASON.md's over TEAM.md's,
    the other file the declaration's `text` or `season.text`), else its default -- as ONE object `{template, text, values: [{name, value,
    from}]}`, `from` `given` or `default`; a value given empty is withdrawn: the team's is not taken; a value with
    none refuses `value-missing`, naming it, exit 2; a template the script does not render refuses
    `template-unknown`. Nothing written; the call journaled with its values and its candidate as JSON."""
    template = words[words.index("--render") + 1] if "--render" in words[:-1] else "?"
    given = dict(words[n + 1].partition("=")[::2] for n, one in enumerate(words) if one == "--value" and n + 1 < len(words))
    typed = sys.stdin.read() if "--text-file" in words else None
    season = "--season" in words
    log("templates --render " + template + "".join(f" {name}={value}" for name, value in given.items())
        + ("" if typed is None else f" --text-file{' --season' if season else ''} {json.dumps(typed)}"))
    if script.get("render_sleep"):
        time.sleep(float(script["render_sleep"]))
    found = (script.get("renders") or {}).get(template)
    written = documents().get(template)
    if written is not None:
        found = {"text": written.split("\n---\n", 1)[-1], "values": []}
    if found is None:
        sys.stderr.write(f"pp-team: template-unknown -- `{template}`: no such template (`team templates`).\n")
        return 2
    team = words[words.index("--team") + 1] if "--team" in words[:-1] else None
    declared = (((script.get("declarations") or {}).get(team) or {}).get("declared") or {}) if team else {}
    applied = {str(one.get("name")): str(one.get("value")) for one in declared.get("values") or []
               if isinstance(one, dict) and one.get("value") is not None}
    if typed is not None:                  # the candidate in the place of its file, the other file as the script has it
        face = (script.get("declarations") or {}).get(team) or {}
        team_text = face.get("text") if season else typed
        season_text = typed if season else (face.get("season") or {}).get("text")
        applied = {**values_written(team_text), **values_written(season_text)}
    text, values = str(found.get("text") or ""), []
    for one in found.get("values") or []:
        name = one["name"]
        if name in given and given[name] != "":
            value, source = given[name], "given"
        elif name in applied and name not in given:
            value, source = applied[name], "default"
        elif one.get("default") is not None:
            value, source = one["default"], "default"
        else:
            sys.stderr.write(f"pp-team: value-missing -- {template}: `{name}` ({one.get('description')}) has no "
                             f"default -- give it, `--value {name}=<value>`.\n")
            return 2
        text = text.replace("{" + name + "}", value)
        values.append({"name": name, "value": value, "from": source})
    print(json.dumps({"template": template, "text": text, "values": values}))
    return 0


def inbox(words: list[str], script: dict) -> int:
    """`inbox <team> --json`: the script's object of the team on one line, nothing when it has none."""
    team = words[0] if words else "?"
    log(f"inbox {team}")
    found = (script.get("inbox") or {}).get(team)
    if found:
        print(json.dumps(found))
    return 0


def stats(words: list[str], script: dict) -> int:
    """`stats <team> --json [--all | --season <n>]`: the script's seasons of the team, as the verb says them."""
    every = "--all" in words
    chosen = words[words.index("--season") + 1] if "--season" in words[:-1] else None
    team = next((one for one in words if not one.startswith("--") and one != chosen), "?")
    log(f"stats {team}" + (" --all" if every else "") + (f" --season {chosen}" if chosen else ""))
    found = (script.get("stats") or {}).get(team)
    if found and found.get("sleep"):          # a verb that tarries: what a team chosen during its reading meets
        time.sleep(float(found["sleep"]))
    if not found or not found.get("seasons"):
        sys.stderr.write(f"pp-team: team-not-started -- {team} was never started.\n")
        return 2
    seasons = found["seasons"]
    if every:
        print(json.dumps({"team": team, "base": "usd", "seasons": [one for one in seasons if not one.get("empty")],
                          "median": found.get("median") or {}, "empty": [one["season"] for one in seasons
                                                                        if one.get("empty")],
                          "by_task": found.get("by_task") or []}))
        return 0
    one = seasons[-1] if chosen is None else next((one for one in seasons if str(one.get("season")) == chosen), None)
    if one is None:
        sys.stderr.write(f"pp-team: season-unknown -- {team} has no season `{chosen}`.\n")
        return 2
    print(json.dumps({"team": team, "base": "usd", "season": one}))
    return 0


def declaration(words: list[str], script: dict) -> int:
    """`declaration <team> --json`: the script's object of the team; `team-unknown` without one. Under `--text-file -`
    (and `--season`), a CANDIDATE text read on the standard input: journaled with the text as JSON, answered with the
    script's `candidates` object of the team -- the declaration as if that text were written -- or its `candidate_refusal`
    line on stderr, exit 2."""
    team = words[0] if words else "?"
    if "--text-file" in words:
        text = sys.stdin.read()
        season = " --season" if "--season" in words else ""
        log(f"declaration {team} --text-file{season} {json.dumps(text)}")
        if script.get("candidate_refusal"):
            sys.stderr.write(str(script["candidate_refusal"]))
            return 2
        found = (script.get("candidates") or {}).get(team) or (script.get("declarations") or {}).get(team)
        print(json.dumps(found))
        return 0
    log(f"declaration {team}")
    found = (script.get("declarations") or {}).get(team)
    if found is None:
        sys.stderr.write(f"pp-team: team-unknown -- no teams/{team}/TEAM.md\n")
        return 2
    if team in stopped() and isinstance(found.get("started"), dict):
        found = {**found, "started": {**found["started"], "state": "stopped"}}
    print(json.dumps(found))
    return 0


def gesture(verb: str, script: dict) -> int:
    """A gesture of the post: its whole argv kept, what the script says it answers said back. `delete` without
    `--yes` is the dry run: the script's `deletes` object of the team, unless an answer refuses."""
    log("team " + shlex.join(sys.argv[1:]))
    words = sys.argv[2:]
    if any(one == "--body-file" and words[n + 1:n + 2] == ["-"] for n, one in enumerate(words)):
        log("body " + json.dumps(sys.stdin.read()))       # the body a `declare` reads on its standard input
    answers = script.get("answers") or {}
    seasoned = f"{verb} --season"               # a `declare --season` answers apart when the script says so
    answer = answers.get(seasoned if "--season" in sys.argv[2:] and seasoned in answers else verb) or {}
    team = sys.argv[2] if len(sys.argv) > 2 else "?"
    if verb == "delete" and "--yes" not in sys.argv[2:] and not answer.get("rc"):
        print(json.dumps((script.get("deletes") or {}).get(team) or {"team": team, "dry": True}))
        return 0
    sys.stdout.write(str(answer.get("out") or ""))
    sys.stderr.write(str(answer.get("err") or ""))
    if verb == "declare" and "--json" in sys.argv[2:] and not answer.get("rc") and not answer.get("out"):
        file = "SEASON.md" if "--season" in sys.argv[2:] else "TEAM.md"
        print(json.dumps({"team": team, "file": f"teams/{team}/{file}", "written": [],
                          "verdict": answer.get("verdict") or {"ok": True, "refusal": None}, "pending": []}))
    if verb == "document" and not answer.get("rc"):
        name, changed = sys.argv[2], documents()
        if "--new" in words:
            changed[name] = f'---\ndescription: ""\n---\n# {name}\n'
        elif "--delete" in words:
            changed[name] = None
        elif "--body-file" in words:
            changed[name] = json.loads(journal_last_body())
        documents_kept(changed)
        print(json.dumps({"template": name, "done": "new" if "--new" in words else "deleted" if "--delete" in words
                          else "written", "path": f".pp/teams/templates/{name}.md", "package": False}))
    if verb == "stop" and not answer.get("rc") and os.environ.get("PP_UI_TEAM_LOG"):
        path = Path(os.environ["PP_UI_TEAM_LOG"] + ".stopped.json")
        path.write_text(json.dumps(stopped() + [team]), encoding="utf-8")
    if verb == "delete" and not answer.get("rc") and os.environ.get("PP_UI_TEAM_LOG"):
        path = Path(os.environ["PP_UI_TEAM_LOG"] + ".deleted.json")
        path.write_text(json.dumps(deleted() + [team]), encoding="utf-8")
    if answer.get("sleep"):                   # a gesture that tarries: its end said once it comes
        time.sleep(float(answer["sleep"]))
        log("ended team " + shlex.join(sys.argv[1:]))
    return int(answer.get("rc") or 0)


def main() -> int:
    script = json.loads(Path(os.environ["PP_UI_TEAM_SCRIPT"]).read_text(encoding="utf-8"))
    verb = sys.argv[1] if len(sys.argv) > 1 else "?"
    if verb == "inbox" and "--json" in sys.argv[2:]:
        return inbox([one for one in sys.argv[2:] if one != "--json"], script)
    if verb == "templates" and "--render" in sys.argv[2:]:
        return rendered(sys.argv[2:], script)
    if verb == "templates":
        return templates("--json" in sys.argv[2:], script)
    if verb == "document" and not any(one in ACTIONS for one in sys.argv[2:]):
        return source([one for one in sys.argv[2:] if one != "--json"], script)
    if verb == "stats":
        return stats([one for one in sys.argv[2:] if one != "--json"], script)
    if verb == "declaration":
        return declaration([one for one in sys.argv[2:] if one not in ("--json", "-")], script)
    if verb in GESTURES:
        return gesture(verb, script)
    if verb == "responses":
        return responses(sys.argv[2:], script)
    given = sys.argv[2:]
    task = given[given.index("--task") + 1] if "--task" in given and given.index("--task") + 1 < len(given) else None
    if task is not None:
        at = given.index("--task")
        given = given[:at] + given[at + 2:]
    words = [one for one in given if one != "--json" and not one.startswith("--heartbeat")]
    words = [one for one in words if not one.isdigit()]
    if verb == "status":
        return status(words, script)
    if verb == "watch":
        return watch(words, task, script)
    if verb == "log":
        return journal(words, task, script)
    if verb == "result":
        return result(words, script)
    log(f"{verb} {' '.join(sys.argv[2:])}".rstrip())
    sys.stderr.write(f"pp-team: verb-unknown -- {verb}\n")
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
