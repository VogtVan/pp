#!/usr/bin/env python3
"""pp-team -- the bench's WITNESS of the faces of `team`, for the Teams tab of the post. Posed by
`PP_UI_FACES` under the name `team`, it replays the script `PP_UI_TEAM_SCRIPT` names -- a JSON
object: `badges` (the objects `status --json` prints without a name, one per line), `states`
(`{<team>: [<object>, …]}`: what `status <team> --json` prints, ONE object per call, consumed call
after call, the last one replayed), `refuse` (`{<team>: "<line>"}`: the line said on stderr, exit 2,
for `status <team>`), `watch` (`{<team>: [<object> | {"sleep": <seconds>}, …]}`, a task's under
`<team>/<task>` for `watch <team> --task <task>`: what the watch writes on STDERR, one object per line,
`at` added when absent and `team` to an event of the journal -- an object with an `id`, or `quiet` --,
never to a STEP of a wake-up; then it waits until it is ended), `log` (`{<team>: [<object>, …]}`, a
task's under `<team>/<task>`: what `log <team> --json [--task <task>]` prints, one per line -- or a list
of such lists, one per call, consumed call after call, the last one replayed),
`results` (`{<team>/<task>: <value>}`: what `result <team> <task>` prints as JSON; a task without one
refuses `task-open`, exit 2), `responses` (`{<team>: [<object>, …]}`: what `responses <team> --json [--agent <member>]` prints, one per
line, those of the member named alone), `inbox` (`{<team>: <object>}`: what `inbox <team> --json` prints on one
line, nothing when the team has none), `declarations` (`{<team>: <object>}`: what `declaration <team> --json`
prints; a team without one refuses `team-unknown`, exit 2), `templates` (`[<object>, …]`: what `templates --json`
prints, one per line; without `--json`, one line `<template>  <members> -- <description>` each), `answers` (`{<verb>: {rc, out, err}}`: what a GESTURE
-- `post`, `stop`, `tick`, `inbox --seen`, `reset`, `pause`, `resume`, `start`, `ring`, `budget`, `new` -- answers, rc 0 and nothing
said by default). With `PP_UI_TEAM_LOG` named, one line per call is appended -- `status`, `status <team>`, `watch
<team> [<task>]`, `log <team> [<task>]`, `result <team> <task>`, `inbox <team>`, `declaration <team>`, `templates`,
and a
gesture as `team <its argv, quoted as a shell would>` --, and
`watch-end <team> [<task>]` when a watch is ended by SIGTERM: how the bench counts the readings and
sees a watch closed. The calls of `status <team>` consumed are kept beside the journal
(`<log>.seen.json`)."""
from __future__ import annotations

import fcntl
import json
import os
import shlex
import signal
import sys
import time
from datetime import datetime, timezone
from pathlib import Path


def log(line: str) -> None:
    where = os.environ.get("PP_UI_TEAM_LOG")
    if where:
        with open(where, "a", encoding="utf-8") as journal:
            journal.write(line + "\n")


def consumed(team: str) -> int:
    """-> how many `status <team>` calls were played before this one, and counts this one -- under a lock: the post
    reads several teams at once."""
    where = os.environ.get("PP_UI_TEAM_LOG")
    if not where:
        return 0
    path = Path(where + ".seen.json")
    with open(where + ".seen.lock", "a", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        seen = json.loads(path.read_text(encoding="utf-8")) if path.is_file() else {}
        before = int(seen.get(team, 0))
        seen[team] = before + 1
        path.write_text(json.dumps(seen), encoding="utf-8")
    return before


def status(words: list[str], script: dict) -> int:
    if not words:
        log("status")
        for one in script.get("badges") or []:
            print(json.dumps(one))
        return 0
    team = words[0]
    log(f"status {team}")
    refused = (script.get("refuse") or {}).get(team)
    if refused:
        sys.stderr.write(str(refused) + "\n")
        return 2
    states = (script.get("states") or {}).get(team) or [{"team": team, "started": None}]
    print(json.dumps(states[min(consumed(team), len(states) - 1)]))
    return 0


def watch(words: list[str], task: str | None, script: dict) -> int:
    team = words[0] if words else "?"
    named = f"{team} {task}" if task else team
    log(f"watch {named}")

    def ended(*_: object) -> None:
        log(f"watch-end {named}")
        raise SystemExit(0)
    signal.signal(signal.SIGTERM, ended)
    for one in (script.get("watch") or {}).get(f"{team}/{task}" if task else team) or []:
        if "sleep" in one:
            time.sleep(float(one["sleep"]))
            continue
        event = "id" in one or one.get("event") == "quiet"     # a step of a wake-up names no team
        said = {"at": datetime.now(timezone.utc).isoformat(timespec="seconds"), **({"team": team} if event else {}),
                **one}
        sys.stderr.write(json.dumps(said) + "\n")
        sys.stderr.flush()
    while True:                            # a watch runs until it is ended
        time.sleep(1)


def journal(words: list[str], task: str | None, script: dict) -> int:
    team = words[0] if words else "?"
    log(f"log {team} {task}" if task else f"log {team}")
    key = f"{team}/{task}" if task else team
    found = (script.get("log") or {}).get(key) or []
    if found and isinstance(found[0], list):               # one list per call
        found = found[min(consumed(f"log:{key}"), len(found) - 1)]
    for one in found:
        print(json.dumps(one))
    return 0


def responses(given: list[str], script: dict) -> int:
    """`responses <team> --json [--agent <member>]`: the script's responses of the team, the member's alone."""
    member = given[given.index("--agent") + 1] if "--agent" in given and given.index("--agent") + 1 < len(given) else None
    team = next((one for one in given if not one.startswith("--") and one != member), "?")
    log(f"responses {team} {member}" if member else f"responses {team}")
    for one in (script.get("responses") or {}).get(team) or []:
        if member is None or one.get("member") == member:
            print(json.dumps(one))
    return 0


def result(words: list[str], script: dict) -> int:
    team, task = (words + ["?", "?"])[:2]
    log(f"result {team} {task}")
    found = script.get("results") or {}
    if f"{team}/{task}" not in found:
        sys.stderr.write(f"pp-team: task-open -- {task} is open: no result yet.\n")
        return 2
    print(json.dumps(found[f"{team}/{task}"]))
    return 0


GESTURES = ("post", "stop", "tick", "inbox", "reset", "pause", "resume", "start", "ring", "budget", "new")


def templates(as_json: bool, script: dict) -> int:
    """`templates [--json]`: the script's templates, one per line."""
    log("templates --json" if as_json else "templates")
    for one in script.get("templates") or []:
        print(json.dumps(one) if as_json else f"{one.get('template')}  {', '.join(one.get('members') or [])} -- "
              f"{one.get('description')}")
    return 0


def inbox(words: list[str], script: dict) -> int:
    """`inbox <team> --json`: the script's object of the team on one line, nothing when it has none."""
    team = words[0] if words else "?"
    log(f"inbox {team}")
    found = (script.get("inbox") or {}).get(team)
    if found:
        print(json.dumps(found))
    return 0


def declaration(words: list[str], script: dict) -> int:
    """`declaration <team> --json`: the script's object of the team; `team-unknown` without one."""
    team = words[0] if words else "?"
    log(f"declaration {team}")
    found = (script.get("declarations") or {}).get(team)
    if found is None:
        sys.stderr.write(f"pp-team: team-unknown -- no teams/{team}/TEAM.md\n")
        return 2
    print(json.dumps(found))
    return 0


def gesture(verb: str, script: dict) -> int:
    """A gesture of the post: its whole argv kept, what the script says it answers said back."""
    log("team " + shlex.join(sys.argv[1:]))
    answer = (script.get("answers") or {}).get(verb) or {}
    sys.stdout.write(str(answer.get("out") or ""))
    sys.stderr.write(str(answer.get("err") or ""))
    return int(answer.get("rc") or 0)


def main() -> int:
    script = json.loads(Path(os.environ["PP_UI_TEAM_SCRIPT"]).read_text(encoding="utf-8"))
    verb = sys.argv[1] if len(sys.argv) > 1 else "?"
    if verb == "inbox" and "--json" in sys.argv[2:]:
        return inbox([one for one in sys.argv[2:] if one != "--json"], script)
    if verb == "templates":
        return templates("--json" in sys.argv[2:], script)
    if verb == "declaration":
        return declaration([one for one in sys.argv[2:] if one != "--json"], script)
    if verb in GESTURES:
        return gesture(verb, script)
    if verb == "responses":
        return responses(sys.argv[2:], script)
    given = sys.argv[2:]
    task = given[given.index("--task") + 1] if "--task" in given and given.index("--task") + 1 < len(given) else None
    if task is not None:
        at = given.index("--task")
        given = given[:at] + given[at + 2:]
    words = [one for one in given if one != "--json" and not one.startswith("--heartbeat")]
    words = [one for one in words if not one.isdigit()]
    if verb == "status":
        return status(words, script)
    if verb == "watch":
        return watch(words, task, script)
    if verb == "log":
        return journal(words, task, script)
    if verb == "result":
        return result(words, script)
    log(f"{verb} {' '.join(sys.argv[2:])}".rstrip())
    sys.stderr.write(f"pp-team: verb-unknown -- {verb}\n")
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
